<Window
    x:Class="Glassline.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glassline="using:Glassline.WinUI.Controls"
    Title="Glassline Gallery">
    <Grid>
        <Border
            x:Name="WindowSolidFallback"
            Background="{ThemeResource Glassline.Surface.Window}"
            IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <glassline:GlasslineGlassContainer
                x:Name="TitleBarMaterialRegion"
                Grid.Row="0"
                AutomationProperties.Name="Titlebar band material region"
                Material="Toolbar"
                Quality="Auto">
                <TitleBar
                    x:Name="GalleryTitleBar"
                    AutomationProperties.AutomationId="Scene.TitleBarBand"
                    Subtitle="shared material band"
                    Title="Glassline Gallery" />
            </glassline:GlasslineGlassContainer>
            <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="GalleryRoot" Padding="32" Spacing="20">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource Glassline.Text.Primary}" Text="Glassline.WinUI" />
                <TextBlock x:Name="RequestedSceneStatus" Style="{StaticResource Glassline.CaptionTextStyle}" />

                <Border
                    x:Name="DiagnosticsPanel"
                    Padding="12"
                    Background="{ThemeResource Glassline.Surface.Group}"
                    CornerRadius="{StaticResource Glassline.Radius.Group}"
                    AutomationProperties.AutomationId="Diagnostics.MaterialRuntime">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource Glassline.BodyTextStyle}" Text="Runtime diagnostics" />
                        <TextBlock x:Name="BackdropStatus" Style="{StaticResource Glassline.CaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="EnvironmentStatus" Style="{StaticResource Glassline.CaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MaterialStatus" Style="{StaticResource Glassline.CaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="RegionStatus" Style="{StaticResource Glassline.CaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TitleBarStatus" Style="{StaticResource Glassline.CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="SceneWindowFoundation"
                    Padding="16"
                    Background="{ThemeResource Glassline.Surface.Group}"
                    CornerRadius="{StaticResource Glassline.Radius.Group}"
                    AutomationProperties.AutomationId="Scene.WindowFoundation">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Window foundation" />
                        <TextBlock Style="{StaticResource Glassline.CaptionTextStyle}" Text="Native Window.SystemBackdrop supplies Mica when policy permits; the semantic window surface is restored for Solid mode." TextWrapping="Wrap" />
                        <Button Content="Native WinUI behavior" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <StackPanel
                    x:Name="SceneMaterialRegions"
                    Spacing="12"
                    AutomationProperties.AutomationId="Scene.MaterialRegions">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Shared material regions" />
                    <glassline:GlasslineGlassContainer
                        x:Name="SidebarMaterialRegion"
                        AutomationProperties.Name="Shared sidebar material region"
                        Material="Sidebar"
                        Quality="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource Glassline.CaptionTextStyle}" Text="Sidebar region" />
                            <Button Content="Overview" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            <Button Content="Components" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            <Button Content="Diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </glassline:GlasslineGlassContainer>
                    <glassline:GlasslineGlassContainer
                        x:Name="ToolbarMaterialRegion"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Shared toolbar material region"
                        Material="Toolbar"
                        Quality="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource Glassline.CaptionTextStyle}" Text="Toolbar region" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Back" />
                                <Button Content="Forward" />
                                <Button Content="Share" />
                            </StackPanel>
                        </StackPanel>
                    </glassline:GlasslineGlassContainer>
                </StackPanel>

                <Border
                    x:Name="SceneControlsMatrix"
                    Padding="16"
                    Background="{ThemeResource Glassline.Surface.Group}"
                    CornerRadius="{StaticResource Glassline.Radius.Group}"
                    AutomationProperties.AutomationId="Scene.ControlsMatrix">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Controls matrix baseline" />
                        <TextBlock Style="{StaticResource Glassline.CaptionTextStyle}" Text="Native TextBox and ListBox engines remain inside the Glassline composite controls." TextWrapping="Wrap" />
                        <glassline:GlasslineSearchField
                            x:Name="SearchField"
                            Width="320"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Gallery search"
                            PlaceholderText="Search components" />
                        <glassline:GlasslineSearchField
                            Width="320"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            AutomationProperties.Name="Disabled gallery search"
                            PlaceholderText="Disabled search" />
                        <glassline:GlasslineSegmentedControl
                            x:Name="SegmentedControl"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Gallery view mode"
                            SelectedIndex="0" />
                        <TextBlock x:Name="SelectionStatus" Style="{StaticResource Glassline.CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="SceneBenchmarkSettings"
                    Padding="16"
                    Background="{ThemeResource Glassline.Surface.Group}"
                    CornerRadius="{StaticResource Glassline.Radius.Group}"
                    AutomationProperties.AutomationId="Scene.BenchmarkSettings"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Benchmark — Settings 100 rows" />
                        <TextBlock Style="{StaticResource Glassline.CaptionTextStyle}" Text="Deterministic native ListView workload. Capture performance only on the native Windows benchmark lane." TextWrapping="Wrap" />
                        <ListView x:Name="SettingsBenchmarkList" Height="560" AutomationProperties.AutomationId="Benchmark.Settings.List" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="SceneBenchmarkGrid"
                    Padding="16"
                    Background="{ThemeResource Glassline.Surface.Group}"
                    CornerRadius="{StaticResource Glassline.Radius.Group}"
                    AutomationProperties.AutomationId="Scene.BenchmarkGrid"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Benchmark — Productivity grid 500 items" />
                        <TextBlock Style="{StaticResource Glassline.CaptionTextStyle}" Text="Deterministic native GridView workload." />
                        <GridView x:Name="GridBenchmark" Height="560" AutomationProperties.AutomationId="Benchmark.Grid.Items" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="SceneBenchmarkTree"
                    Padding="16"
                    Background="{ThemeResource Glassline.Surface.Group}"
                    CornerRadius="{StaticResource Glassline.Radius.Group}"
                    AutomationProperties.AutomationId="Scene.BenchmarkTree"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Benchmark — Tree 5k nodes" />
                        <TextBlock Style="{StaticResource Glassline.CaptionTextStyle}" Text="100 roots × 50 children = 5000 non-root nodes." />
                        <TreeView x:Name="TreeBenchmark" Height="560" AutomationProperties.AutomationId="Benchmark.Tree.Nodes" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
