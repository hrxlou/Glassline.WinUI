<Window
    x:Class="Glassline.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glassline Gallery">
    <Grid Padding="32">
        <StackPanel Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Glassline.WinUI" />
            <TextBlock Text="Build baseline: shipping controls are added in later work items." TextWrapping="Wrap" />
            <Button Content="Native WinUI baseline" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Window>
