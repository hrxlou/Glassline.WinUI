<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glassline.WinUI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Glassline.WinUI.Theme/Themes/GlasslineTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="controls:GlasslineSearchField">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlasslineSearchField">
                    <Grid>
                        <TextBox
                            x:Name="PART_Input"
                            Padding="10,4,40,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            PlaceholderText="{TemplateBinding PlaceholderText}" />
                        <Button
                            x:Name="PART_ClearButton"
                            Width="32"
                            Height="28"
                            Margin="0,2,2,2"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Clear search"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="×" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:GlasslineSegmentedControl">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlasslineSegmentedControl">
                    <Border
                        Padding="2"
                        Background="{ThemeResource Glassline.Surface.Group}"
                        CornerRadius="{StaticResource Glassline.Radius.Control}">
                        <ListBox
                            x:Name="PART_Selector"
                            HorizontalContentAlignment="Stretch"
                            SelectionMode="Single"
                            Background="Transparent"
                            BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
