<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glassline.WinUI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Glassline.WinUI.Theme/Themes/GlasslineTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="controls:GlasslineSearchField">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlasslineSearchField">
                    <Grid>
                        <TextBox
                            x:Name="PART_Input"
                            Padding="10,4,40,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            PlaceholderText="{TemplateBinding PlaceholderText}" />
                        <Button
                            x:Name="PART_ClearButton"
                            Width="32"
                            Height="28"
                            Margin="0,2,2,2"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Clear search"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="×" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:GlasslineSegmentedControl">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlasslineSegmentedControl">
                    <Border
                        Padding="2"
                        Background="{ThemeResource Glassline.Surface.Group}"
                        CornerRadius="{StaticResource Glassline.Radius.Control}">
                        <ListBox
                            x:Name="PART_Selector"
                            HorizontalContentAlignment="Stretch"
                            SelectionMode="Single"
                            Background="Transparent"
                            BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:GlasslineGlassContainer">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlasslineGlassContainer">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="MaterialRoleStates">
                                <VisualState x:Name="Sidebar">
                                    <VisualState.Setters>
                                        <Setter Target="FallbackSurface.Background" Value="{ThemeResource Glassline.Surface.Sidebar}" />
                                        <Setter Target="TintSurface.Background" Value="{ThemeResource Glassline.Surface.Sidebar}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Toolbar">
                                    <VisualState.Setters>
                                        <Setter Target="FallbackSurface.Background" Value="{ThemeResource Glassline.Surface.Toolbar}" />
                                        <Setter Target="TintSurface.Background" Value="{ThemeResource Glassline.Surface.Toolbar}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Popover">
                                    <VisualState.Setters>
                                        <Setter Target="FallbackSurface.Background" Value="{ThemeResource Glassline.Surface.Popover}" />
                                        <Setter Target="TintSurface.Background" Value="{ThemeResource Glassline.Surface.Popover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Interactive">
                                    <VisualState.Setters>
                                        <Setter Target="FallbackSurface.Background" Value="{ThemeResource Glassline.Surface.Group}" />
                                        <Setter Target="TintSurface.Background" Value="{ThemeResource Glassline.Surface.Group}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Prominent">
                                    <VisualState.Setters>
                                        <Setter Target="FallbackSurface.Background" Value="{ThemeResource Glassline.Surface.Popover}" />
                                        <Setter Target="TintSurface.Background" Value="{ThemeResource Glassline.Surface.Popover}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MaterialQualityStates">
                                <VisualState x:Name="Full">
                                    <VisualState.Setters>
                                        <Setter Target="PART_BackdropElement.Visibility" Value="Visible" />
                                        <Setter Target="FallbackSurface.Opacity" Value="0.10" />
                                        <Setter Target="TintSurface.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Reduced">
                                    <VisualState.Setters>
                                        <Setter Target="PART_BackdropElement.Visibility" Value="Visible" />
                                        <Setter Target="FallbackSurface.Opacity" Value="0.35" />
                                        <Setter Target="TintSurface.Opacity" Value="0.06" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Solid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_BackdropElement.Visibility" Value="Collapsed" />
                                        <Setter Target="FallbackSurface.Opacity" Value="1" />
                                        <Setter Target="TintSurface.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <muxc:SystemBackdropElement
                            x:Name="PART_BackdropElement"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="FallbackSurface"
                            Background="{ThemeResource Glassline.Surface.Toolbar}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="TintSurface"
                            Background="{ThemeResource Glassline.Surface.Toolbar}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
